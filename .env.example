# Database
DATABASE_URL=postgresql+psycopg://kivi:kivi@db:5432/kivi

# Single-user build: owner of every row
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

USER_TIMEZONE=Asia/Kolkata

# LLM provider (Google AI Studio key: https://aistudio.google.com/apikey)
LLM_API_KEY=
LLM_SMALL_MODEL=gemini-3.5-flash-lite
LLM_LARGE_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=60

# Embeddings run locally; no key required
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# App
APP_ENV=development
LOG_LEVEL=info

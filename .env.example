# Copy to .env and fill in the key. .env is gitignored; this file is not,
# so nothing secret belongs below.

# Database
# The host is the compose service name, so this works as-is inside the
# containers. From the host machine the port is published, so swap `db`
# for `localhost`.
DATABASE_URL=postgresql+psycopg://kivi:kivi@db:5432/kivi

# LLM provider
# A Gemini API key from https://aistudio.google.com/apikey. The free tier
# allows 500 requests per day, per project, per model -- and the day
# resets at midnight Pacific, not UTC.
LLM_API_KEY=

# Leave blank to use the version pinned in app/config.py. It is pinned
# rather than aliased so a run is reproducible when the provider ships
# something new, and the pinned value is the one every recorded result
# was produced with -- change it and your numbers stop matching the ones
# in the report.
#
# There is no setting for the large tier. The two-tier mechanism exists
# in app/llm/client.py, but no caller passes tier=LARGE, so every call in
# this build is the small model and a variable here would do nothing.
LLM_SMALL_MODEL=

# Embeddings run locally through fastembed -- no key, no quota, no
# network. Changing this means a migration and re-embedding everything,
# because the stored vectors have a fixed width and a vector from another
# model is not comparable to one from this one.
EMBEDDING_MODEL=

# App
APP_ENV=development
LOG_LEVEL=info

# Set true only to disable the refusal of sensitive dictation, which
# exists so that credentials and medical details are never written down
# at all. There is no good reason to turn this on outside a test.
# STORE_SENSITIVE_CONTENT=false

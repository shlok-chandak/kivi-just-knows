# Node / frontend
node_modules/
.next/
dist/

# Evaluation output. Runs are regenerated by `python -m evaluation.run`, so
# the working directory fills up with intermediate ones -- but the runs the
# README quotes have to be in the repository, or its numbers cannot be
# checked. Those are listed here by name.
evaluation/results/*
!evaluation/results/README.md
!evaluation/results/20260910-final/
!evaluation/results/20260910-105757-original/
!evaluation/results/20260911-182921/
!evaluation/results/systems-20260911-085345/
!evaluation/results/tools-20260910-132354/

# Docker creates these as mountpoints for ./corpus and ./scripts, because
# the container's /app is ./backend. They are always empty on the host.
backend/corpus/
backend/scripts/

# OS / editor
.DS_Store

# Built frontend. Committed on purpose, which is unusual and deliberate:
# compose bind-mounts ./backend over /app, so anything built inside the image
# is shadowed by the host directory. Without these files a fresh clone serves
# no interface at all, and the reviewer is told not to infer missing setup.
# Rebuild with `npm run build` after changing anything under frontend/src.
frontend/node_modules/
frontend/dist/
# Written on every `tsc` run, so it shows as modified constantly and says
# nothing about the source.
frontend/tsconfig.tsbuildinfo
